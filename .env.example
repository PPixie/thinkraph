# Optional absolute path; default is the application's data directory.
# THINKRAPH_DATA_DIR=/absolute/path/to/thinkraph-data
THINKRAPH_PORT=3001
THINKRAPH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Legacy fallback for the model configuration. Prefer the platform settings,
# which store the runtime model configuration in data/config.json.
# The endpoint must not include the trailing /chat/completions path.
THINKRAPH_AI_BASE_URL=
THINKRAPH_AI_API_KEY=
THINKRAPH_AI_MODEL=
THINKRAPH_AI_TIMEOUT_MS=60000

THINKRAPH_GRAPH_MAX_BYTES=10485760
THINKRAPH_SPACE_MAX_BYTES=104857600
THINKRAPH_MAX_GRAPHS=200
